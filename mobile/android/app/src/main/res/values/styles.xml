<resources>
    <style name="FlowDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#28694F</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#28694F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8F4</item>
        <item name="android:navigationBarColor">#F7F8F4</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F8F4</item>
        <item name="android:alertDialogTheme">@style/FlowDialogTheme</item>
    </style>
</resources>
