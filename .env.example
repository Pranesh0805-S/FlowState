# Hosted deployment: PostgreSQL connection string (leave blank for local SQLite)
DATABASE_URL=

# Hosted OTP email via Resend HTTPS API
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional local-development SMTP fallback for registration and recovery OTPs
PRODUCTIVITY_SMTP_EMAIL=
PRODUCTIVITY_SMTP_APP_PASSWORD=
PRODUCTIVITY_SMTP_HOST=smtp.gmail.com
PRODUCTIVITY_SMTP_PORT=587

# Set a long random value before using accounts outside a local demo
PRODUCTIVITY_JWT_SECRET=

# Optional absolute SQLite path for local development (ignored when DATABASE_URL is set)
PRODUCTIVITY_DB_PATH=

# Production frontend origin for API CORS, e.g. https://your-app.vercel.app
WEB_ORIGIN=
